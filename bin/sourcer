#!/usr/bin/python3
import argparse
import os
import sys

gitpath = os.path.join(os.path.dirname(os.path.realpath(sys.argv[0])), "../.git")
if os.path.exists(gitpath):
	# run from git repo
	sys.path.append(os.path.join(os.path.dirname(os.path.realpath(sys.argv[0])), ".."))

from vfscratch.common import Sourcer

CLI_CONFIG = {
	"build": {"positional": True},
	"target": {"positional": True},
	"action": {"positional": True},
	"sources": {"positional": True, "nargs": "?"}
}


def validate_project_root(repo_path):
	required = [
		"bin/sourcer",
		"bin/builder",
		"vfscratch/common.py",
		"vfscratch/builder.py",
		".gitignore"
	]

	missing = []

	for item in required:
		if not os.path.exists(os.path.join(repo_path, item)):
			missing.append(item)

	if missing:
		print("This command must be run from the VFScratch project root.")
		print("Enter the project directory first, then run the command again.")
		print("Example:")
		print("  cd /path/to/VFScratch")
		print("  export CLFS=$(pwd)/newroot")
		print("  bin/sourcer gnu x86-32bit fetch")
		print("")
		print("Missing required project files:")
		for item in missing:
			print(f"  {item}")
		sys.exit(1)


def parse_args():
	ap = argparse.ArgumentParser()
	for arg, kwargs in CLI_CONFIG.items():
		if "positional" in kwargs and kwargs["positional"]:
			new_kwargs = kwargs.copy()
			del new_kwargs["positional"]
			ap.add_argument(arg, **new_kwargs)
		else:
			ap.add_argument("--" + arg, **kwargs)
	return ap.parse_args()


if __name__ == "__main__":
	repo_path = os.getcwd()
	validate_project_root(repo_path)

	if "CLFS" not in os.environ:
		print("CLFS not found in environment; using current working directory/newroot.")
		print("Recommended:")
		print("  export CLFS=$(pwd)/newroot")
		os.environ["CLFS"] = os.path.join(repo_path, "newroot")

	os.makedirs(os.environ["CLFS"], exist_ok=True)

	args = parse_args()

	sourcer = Sourcer(
		args.build,
		repo_path,
		os.environ["CLFS"],
		args.target
	)

	if args.action == "unpack":
		sources = args.sources.split(",")
		sourcer.unpack(sources)
	elif args.action == "fetch":
		sourcer.fetch()


# vim: ts=4 sw=4 noet
